# Supabase
NEXT_PUBLIC_SUPABASE_URL=your_supabase_url
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key

# Cashfree Payments
CASHFREE_CLIENT_ID=your_client_id
CASHFREE_CLIENT_SECRET=your_client_secret
CASHFREE_MODE=sandbox
CASHFREE_RETURN_URL=http://localhost:3000/shop?order_id={order_id}

# Admin credentials (for development)
ADMIN_EMAIL=admin@activbite.com
ADMIN_PASSWORD=changeme

# Application
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Coming soon waitlist
GOOGLE_SHEETS_WEBHOOK_URL=your_google_apps_script_web_app_url

# Wholesale enquiries
# Optional: use a separate webhook for wholesale enquiries.
# If this is blank, the app falls back to GOOGLE_SHEETS_WEBHOOK_URL.
WHOLESALE_ENQUIRY_WEBHOOK_URL=your_wholesale_google_apps_script_web_app_url
