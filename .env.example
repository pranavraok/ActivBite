# Cashfree Payments
CASHFREE_CLIENT_ID=your_client_id
CASHFREE_CLIENT_SECRET=your_client_secret
CASHFREE_MODE=sandbox
CASHFREE_RETURN_URL=http://localhost:3000/shop?order_id={order_id}

# ActivBite Bank of Baroda merchant UPI
# The payment page generates a fresh QR with the exact saved order amount.
NEXT_PUBLIC_ACTIVBITE_UPI_PAYEE_NAME=ACTIVBITE
NEXT_PUBLIC_ACTIVBITE_UPI_ID=acti9481345@barodampay
PAYMENT_CONFIRMATION_WEBHOOK_URL=your_payment_google_apps_script_web_app_url

# Admin credentials (for development)
ADMIN_EMAIL=admin@activbite.com
ADMIN_PASSWORD=changeme
ADMIN_SESSION_SECRET=replace_with_a_long_random_secret
ORDER_PAYMENT_TOKEN_SECRET=replace_with_a_different_long_random_secret

# Application
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Coming soon waitlist
GOOGLE_SHEETS_WEBHOOK_URL=your_google_apps_script_web_app_url

# Wholesale enquiries
# Optional: use a separate webhook for wholesale enquiries.
# If this is blank, the app falls back to GOOGLE_SHEETS_WEBHOOK_URL.
WHOLESALE_ENQUIRY_WEBHOOK_URL=your_wholesale_google_apps_script_web_app_url
WHOLESALE_ENQUIRIES_SHEET_URL=your_google_sheet_url
WHOLESALE_ADMIN_READ_SECRET=replace_with_a_long_random_secret

# Orders and delivery status (same spreadsheet can be used)
ORDERS_SHEET_URL=your_google_sheet_url

# Client business-management workbook displayed inside the admin portal
MANAGEMENT_SHEET_URL=https://docs.google.com/spreadsheets/d/your_management_sheet_id/edit

# Contact enquiries
# If CONTACT_ENQUIRY_WEBHOOK_URL is blank, the app uses GOOGLE_SHEETS_WEBHOOK_URL.
CONTACT_ENQUIRY_WEBHOOK_URL=
CONTACT_ENQUIRIES_SHEET_URL=your_google_sheet_url
